
# ─── Django ─────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=true
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8500
DJANGO_ALLOWED_HOSTS=*

# ─── Orquestador ─────────────────────────────────────────────────────────────
# Lista de providers en orden de prioridad (si el primero falla, se prueba el siguiente).
# Valores válidos: msc, zas
PROVIDER_PRIORITY=msc,zas

# TTL por defecto del QR en segundos (15 minutos).
DEFAULT_EXPIRES_IN=900

# ─── ADB / Dispositivo ───────────────────────────────────────────────────────
# Ruta al ejecutable adb. Si está en PATH, poner solo "adb".
ADB_PATH=adb

# Serial del dispositivo Android (obtener con: adb devices).
# Dejar vacío si solo hay un dispositivo conectado.
ADB_DEVICE_SERIAL=34345fb7

# ─── Mercantil Santa Cruz (MSC) ──────────────────────────────────────────────
# Contraseña de acceso a la app bancaria MSC en el teléfono.
MSC_PASSWORD=tu-contraseña-aqui

# ─── Banco Ganadero (ZAS) ───────────────────────────────────────────────────
# Sin credenciales adicionales — ZAS se controla solo por ADB.
# El paquete Android es: bec.vdb.direct (configurado en banks/zas/automation.py)
