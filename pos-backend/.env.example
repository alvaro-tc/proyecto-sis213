PORT=8000
# Orígenes permitidos por CORS (separados por coma)
# En producción pon la URL pública del frontend, ej: http://123.45.67.89
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=
JWT_SECRET=cambia-este-secreto

# ─── Orquestador QR (api_generador_qr en Django, puerto 8500) ─────────────
# Servicio unificado que coordina varios bancos (MSC, ZAS, ...) con failover.
# Ver api_generador_qr/README.md para detalles.
QR_API_URL=http://localhost:8500
QR_API_KEY=
# URL publica del backend POS para recibir webhooks (created/paid/failover).
# Si esta vacia, el watcher hara polling como fallback. Ej: https://mi-pos.com/api/payment/qr/webhook
QR_PUBLIC_WEBHOOK_URL=
QR_WEBHOOK_SECRET=cambia-este-secreto-qr-webhook

# ─── WhatsApp Provider ───────────────────────────────────────────────────────
# "baileys" = WhatsApp Web (escanea QR, gratis). "meta" = Cloud API oficial de Meta.
WA_PROVIDER=baileys
WHATSAPP_DEFAULT_PREFIX=591

# Anti-baneo Baileys (opcionales)
WHATSAPP_MIN_DELAY_MS=1200
WHATSAPP_MAX_DELAY_MS=4500
WHATSAPP_RATE_PER_MINUTE=25
WHATSAPP_RATE_PER_DAY=800
WHATSAPP_PER_JID_PER_MINUTE=5
WHATSAPP_PER_JID_PER_DAY=30
WHATSAPP_AUTH_DIR=

# ─── Meta Cloud API (sólo cuando WA_PROVIDER=meta) ───────────────────────────
# 1. Crea una app en developers.facebook.com → WhatsApp → Cloud API.
# 2. Obtén el Phone Number ID y un Access Token permanente.
# 3. Configura el webhook URL: https://<tu-dominio>/api/whatsapp/webhook/meta
# 4. Usa el mismo META_VERIFY_TOKEN que configures en Meta Developers.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=pon-aqui-tu-token-de-verificacion

# ─── Groq AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

BOT_WEBHOOK_SECRET=cambia-este-secreto
